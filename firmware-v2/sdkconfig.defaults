# Console output stays readable: the protocol stream shares UART0 with the logs.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y

# 4 MB flash with the project's own partition table.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# LVGL touch UI (ESP32-2432S028R: ILI9341 + XPT2046). The option depends on
# IDF_TARGET_ESP32, so a C5 build leaves the UI out.
CONFIG_WB_LVGL=y

# LVGL 9 tuning for a 320x240 panel on an ESP32 without PSRAM.
CONFIG_LV_COLOR_DEPTH_16=y
# 这块板没有 PSRAM，520KB SRAM 要分给 WiFi、LVGL 和 BLE 三家。
# 32KB 会在 lv_display_add_event_cb 里撞 assert malloc 死循环，48KB 才稳。
# 显示 buffer 那边靠 LCD_DRAW_LINES 降下来给堆让路。
CONFIG_LV_MEM_SIZE_KILOBYTES=48
CONFIG_LV_DEF_REFR_PERIOD=33
CONFIG_LV_USE_LOG=n

# BLE：给手机 APP 接入用的控制通道，顺带能扫周围的广播。
# 经典 ESP32 没有 PSRAM，控制器固定预留 55KB DRAM，所以下面全按最小配。
CONFIG_WB_BLE=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
# 暂时不做 central：手机来连板子，不用板子去连别的设备
# CONFIG_BT_NIMBLE_ROLE_CENTRAL is not set
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=3072
CONFIG_BT_NIMBLE_MAX_BONDS=0
CONFIG_BT_NIMBLE_MAX_CCCDS=0
CONFIG_BT_NIMBLE_WHITELIST_SIZE=1
CONFIG_BT_ALARM_MAX_NUM=10
CONFIG_BTDM_CTRL_BLE_MAX_CONN=1
CONFIG_BTDM_SCAN_DUPL_CACHE_SIZE=10
CONFIG_BTDM_BLE_ADV_REPORT_FLOW_CTRL_NUM=10
CONFIG_BTDM_BLE_ADV_REPORT_DISCARD_THRSHOLD=10

# IRAM 只剩几百字节，把屏幕 SPI 的 ISR 挪回 flash。WiFi 的 IRAM 优化不能动，
# 那是注入和混杂收包的关键路径。
# CONFIG_SPI_MASTER_ISR_IN_IRAM is not set

# 手机端一般会要 185，命令回复一行动辄上百字节，MTU 太小就得切很多片
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=185

# NimBLE 的 mbuf 池默认按"手机侧高吞吐"配的（MSYS_2 24 个 320 字节、
# ACL 24 个 255 字节）。我们只跑命令行协议，一行最多 256 字节，压到最小
# 实测能还给堆 15.9KB，GATT 收发照常。
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=4
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=4
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=6
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=10
CONFIG_BT_NIMBLE_ACL_BUF_COUNT=6
